# Break & Retest Copilot - environment configuration
# Copy to `.env` and fill in only what you use. `.env` is git-ignored.
# Never paste real secrets into this example file.

# --- Storage ---------------------------------------------------------------
# SQLite database location (default: var/copilot.db inside the project).
BRC_DB_PATH=var/copilot.db
# Show the "temporary storage" warning (1) or hide it (0). Leave empty to
# auto-detect Streamlit Community Cloud, whose storage resets on restart.
BRC_EPHEMERAL_STORAGE=

# --- Optional live/historical market data (Databento) ---------------------
# The Databento adapter is implemented but UNTESTED (no credentials were
# available while building). Requires `pip install databento` and a paid plan
# with CME Globex (GLBX.MDP3) access.
DATABENTO_API_KEY=

# --- Optional Telegram notifications --------------------------------------
# Create a bot with @BotFather, then message it once and look up your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional plain-English setup explanations via the Claude API ---------
# Explanations are descriptive only; every price, score and risk number is
# calculated by deterministic code, never by the language model.
ANTHROPIC_API_KEY=
BRC_EXPLAINER_MODEL=claude-opus-5-5
